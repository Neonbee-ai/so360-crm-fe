{
    "compilerOptions": {
        "target": "ESNext",
        "useDefineForClassFields": true,
        "lib": [
            "DOM",
            "DOM.Iterable",
            "ESNext"
        ],
        "allowJs": false,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "module": "ESNext",
        "moduleResolution": "Node",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "react-jsx",
        "declaration": true,
        "outDir": "dist",
        "baseUrl": ".",
        "paths": {
            "@so360/shell-context": ["node_modules/@so360/shell-context/dist", "../so360-shell-fe/packages/shell-context/dist", "../../so360-shell-fe/packages/shell-context/dist", "src/types/stubs/shell-context"],
            "@so360/cross-link": ["node_modules/@so360/cross-link/dist", "../so360-shell-fe/packages/cross-link/dist", "../../so360-shell-fe/packages/cross-link/dist"],
            "@so360/design-system": ["node_modules/@so360/design-system/dist", "../so360-shell-fe/packages/design-system/dist", "../../so360-shell-fe/packages/design-system/dist", "src/types/stubs/design-system"],
            "@so360/event-bus": ["node_modules/@so360/event-bus/dist", "../so360-shell-fe/packages/event-bus/dist", "../../so360-shell-fe/packages/event-bus/dist"],
            "@so360/formatters": ["node_modules/@so360/formatters/dist", "../so360-shell-fe/packages/formatters/dist", "../../so360-shell-fe/packages/formatters/dist", "src/types/stubs/formatters"],
            "react": ["node_modules/@types/react"],
            "react/*": ["node_modules/@types/react/*"],
            "react-dom": ["node_modules/@types/react-dom"],
            "react-dom/*": ["node_modules/@types/react-dom/*"],
            "lucide-react": ["node_modules/lucide-react"]
        }
    },
    "include": [
        "src"
    ],
    "exclude": [
        "src/**/*.spec.ts",
        "src/**/*.spec.tsx",
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "src/test/ds-real"
    ]
}